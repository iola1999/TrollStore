--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64e.x1-ios ]
install-name:    '/System/Library/PrivateFrameworks/Preferences.framework/Preferences'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:         [ _PSDefaultValueKey, _PSTableCellKey, _PSValueKey ]
    objc-classes:    [ PSControlTableCell, PSEditableTableCell, PSListController,
                       PSListItemsController, PSRootController, PSSpecifier,
                       PSSwitchTableCell, PSTableCell, PSViewController ]
    objc-ivars:      [ PSListController._bundleControllers, PSListController._specifiers,
                       PSListController._table, PSSpecifier._name, PSSpecifier._properties,
                       PSSpecifier._shortTitleDict, PSSpecifier._titleDict,
                       PSSpecifier._userInfo, PSSpecifier._values, PSSpecifier.action,
                       PSSpecifier.autoCapsType, PSSpecifier.autoCorrectionType,
                       PSSpecifier.cancel, PSSpecifier.cellType,
                       PSSpecifier.detailControllerClass, PSSpecifier.editPaneClass,
                       PSSpecifier.getter, PSSpecifier.keyboardType, PSSpecifier.setter,
                       PSSpecifier.target, PSSpecifier.textFieldType ]
...
